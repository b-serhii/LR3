digraph G {graph [rankdir=TB,dpi=165,bgcolor="white",nodesep=0.40,ranksep=0.45]; node [shape=box,style="rounded",color="black",fontcolor="black",fontname="DejaVu Sans",fontsize=13,margin="0.24,0.14"]; edge [color="black",fontname="DejaVu Sans",arrowsize=0.7]; start [shape=ellipse,label="Початок"];input [label="Ввести f, x₀, y₀, X, n"]; init [label="h=(X−x₀)/n; i=0"];cond [shape=diamond,label="i < n?"];k1 [label="k₁=f(xᵢ,yᵢ)"];k23 [label="k₂=f(xᵢ+h/2, yᵢ+h·k₁/2)\nk₃=f(xᵢ+h/2, yᵢ+h·k₂/2)"];k4 [label="k₄=f(xᵢ+h, yᵢ+h·k₃)"];step [label="yᵢ₊₁=yᵢ+h(k₁+2k₂+2k₃+k₄)/6"];inc [label="xᵢ₊₁=xᵢ+h; i=i+1"];out [label="Вивести вузли, похибки, k₁…k₄"];end [shape=ellipse,label="Кінець"];start->input->init->cond;cond->k1 [label="так"];k1->k23->k4->step->inc->cond;cond->out [label="ні"];out->end; }