digraph G {graph [rankdir=TB,dpi=165,bgcolor="white",nodesep=0.40,ranksep=0.45]; node [shape=box,style="rounded",color="black",fontcolor="black",fontname="DejaVu Sans",fontsize=13,margin="0.24,0.14"]; edge [color="black",fontname="DejaVu Sans",arrowsize=0.7];graph [rankdir=LR];node [shape=record,style="solid",fontsize=12];ui[label="{WebUI|+ render()\\l+ animate()\\l+ selectStrategy()\\l}"];solver[label="{ODEContext|+ solve(problem, strategy)\\l+ validate()\\l}"];base[label="{«Strategy»\\nNumericMethod|+ step(f,x,y,h)\\l}"];eu[label="{EulerStrategy|+ step()\\l}"];he[label="{HeunStrategy|+ step()\\l}"];rk[label="{RK4Strategy|+ step()\\l}"];plot[label="{SVGChart|+ renderPlot()\\l+ autoScale()\\l}"];ui->solver [label="використовує"];solver->base [label="делегує"];eu->base [arrowhead=empty];he->base [arrowhead=empty];rk->base [arrowhead=empty];ui->plot [label="відображає"]; }