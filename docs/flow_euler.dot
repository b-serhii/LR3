digraph G {graph [rankdir=TB,dpi=165,bgcolor="white",nodesep=0.40,ranksep=0.45]; node [shape=box,style="rounded",color="black",fontcolor="black",fontname="DejaVu Sans",fontsize=13,margin="0.24,0.14"]; edge [color="black",fontname="DejaVu Sans",arrowsize=0.7]; start [shape=ellipse,label="Початок"]; input [label="Ввести f, x₀, y₀, X, n"]; init [label="h=(X−x₀)/n; i=0"]; cond [shape=diamond,label="i < n?"]; step [label="k₁=f(xᵢ,yᵢ)\nyᵢ₊₁=yᵢ+h·k₁"]; inc [label="xᵢ₊₁=xᵢ+h; i=i+1"]; out [label="Вивести вузли та похибки"]; end [shape=ellipse,label="Кінець"];start->input->init->cond;cond->step [label="так"];step->inc->cond;cond->out [label="ні"];out->end; }